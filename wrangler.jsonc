{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Renaming this creates a NEW Worker on a NEW workers.dev URL. The two
	// secrets are per Worker, so after the first deploy re-run:
	//   npx wrangler secret put SITE_PASSWORD
	//   npx wrangler secret put SESSION_SECRET
	// Without them the gate fails closed with a 503, which is intended.
	"name": "speed-x-lyka-accelerator",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-07-29",
	"assets": {
		"directory": "./dist/",
		// The Worker needs the binding to serve assets once a visitor is authenticated.
		"binding": "ASSETS",
		// Mirrors the netlify.toml SPA redirect: any unmatched path serves
		// index.html with a 200, so the Page enum switch in App.tsx handles routing.
		// env.ASSETS.fetch() applies this too, so authenticated deep links still work.
		"not_found_handling": "single-page-application",
		// REQUIRED for the password gate. Without this, Cloudflare serves any
		// request that matches a file straight from the asset layer and the Worker
		// never runs, leaving every image, video and script ungated.
		// Trade off: every request is now a billed Worker invocation rather than a
		// free static asset request. Free plan allows 100,000 per day.
		"run_worker_first": true
	},
	"observability": {
		"enabled": true
	}
}
